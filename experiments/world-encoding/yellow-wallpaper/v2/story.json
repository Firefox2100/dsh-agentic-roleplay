    {
      "id": "e21",
      "when": {
        "seq": 21,
        "approx": "the night before they leave"
      },
      "kind": "act",
      "place": "nursery",
      "text": "On the last day John stayed in town overnight; Jennie wanted to sleep with her and she refused; at moonlight she believed the woman crawled and shook the pattern while she pulled, and by morning yards of paper were peeled, as high as her head and half around the room.",
      "who": [
        {
          "id": "narrator",
          "role": "agent"
        },
        {
