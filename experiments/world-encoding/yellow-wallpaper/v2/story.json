    {
      "id": "e08",
      "when": {
        "seq": 8
      },
      "kind": "speech",
      "place": "nursery",
      "text": "John said he would send her to Weir Mitchell in the fall if she did not pick up faster; she did not want to go, having a friend who had been in his hands.",
