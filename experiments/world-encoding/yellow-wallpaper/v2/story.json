    {
      "id": "e25",
      "when": {
        "seq": 25
      },
      "kind": "speech",
      "place": "nursery",
      "text": "John stopped by the door and cried 'What is the matter? For God's sake, what are you doing?'; she crept on, looking over her shoulder, and said she had got out at last in spite of him and Jane, and pulled off most of the paper so he could not put her back; he fainted across her path and she crept over him each time she came round.",
      "who": [
        {
          "id": "john",
          "role": "experiencer"
        },
        {
          "id": "narrator",
          "role": "speaker"
        }
      ],
      "src": [
        "P264",
        "P265",
        "P266",
        "P267"
      ],
      "says": "I've got out at last, in spite of you and Jane! And I've pulled off most of the paper, so you can't put me back!",
      "claims": [
        "c-jane-is-narrator"
      ],
      "importance": 5,
      "note": "the diary ends here; whether it is written during or after is not said"
