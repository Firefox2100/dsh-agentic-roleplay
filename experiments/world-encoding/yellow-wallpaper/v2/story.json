    },
    {
      "id": "e19",
      "when": {
        "seq": 19
      },
      "kind": "perceive",
      "place": "garden-lane",
      "text": "She saw the woman out of every window creeping in the lane, the arbors and on the road, hiding under the blackberry vines when a carriage came; she locked the door when she crept by daylight and did not creep at night for fear John would suspect.",
      "who": [
        {
          "id": "narrator",
          "role": "experiencer"
        }
      ],
      "src": [
