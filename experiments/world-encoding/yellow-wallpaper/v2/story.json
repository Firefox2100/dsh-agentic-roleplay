    {
      "id": "e18",
      "when": {
        "seq": 18
      },
      "kind": "perceive",
      "place": "nursery",
      "text": "At night she discovered that the front pattern moves because the woman behind it shakes it; sometimes there are many women and sometimes one; they are strangled by the pattern, which is why it has so many heads.",
      "who": [
        {
          "id": "narrator",
          "role": "experiencer"
        }
      ],
      "src": [
