    {
      "id": "e01",
      "when": {
        "seq": 1,
        "approx": "the first day",
        "precision": "day"
      },
      "kind": "act",
      "place": "nursery",
      "text": "They took the nursery at the top of the house, not the downstairs room she wanted: John would not hear of it, saying the nursery had air and room, with its barred windows, rings in the walls and torn paper.",
      "who": [
        {
          "id": "john",
          "role": "agent"
        },
        {
          "id": "narrator",
          "role": "patient"
        }
      ],
      "src": [
