  "events": [
    {
      "id": "e00",
      "when": {
        "seq": 0,
        "approx": "a former period; the drop is undated"
      },
      "kind": "state-change",
      "place": null,
      "text": "Jim was paid $30 a week during a former period of prosperity; his pay shrank to $20.",
      "who": [
        {
          "id": "jim",
          "role": "experiencer"
        }
      ],
      "src": [
        "P05"
      ],
      "note": "see states weekly_pay"
    },
    {
      "id": "b01",
      "when": {
        "seq": -3,
        "approx": "the months before Christmas Eve",
        "before": [
          "e01"
        ]
      },
      "kind": "habit",
      "place": null,
      "text": "For months Della saved pennies one and two at a time by bargaining hard with the grocer, the vegetable man and the butcher, until her cheeks burned at the thought of seeming stingy.",
      "who": [
        {
          "id": "della",
          "role": "agent"
        },
        {
          "id": "grocer-etc",
          "role": "patient"
        }
      ],
      "src": [
        "P01",
        "P06"
      ],
      "frequency": "iterative"
    },
    {
      "id": "b02",
      "when": {
        "seq": -2,
        "approx": "every evening"
      },
      "kind": "habit",
      "place": "flat",
      "text": "Whenever Jim came home and reached the flat, Della called him Jim and hugged him greatly.",
      "who": [
        {
          "id": "della",
          "role": "agent"
        },
        {
          "id": "jim",
          "role": "patient"
        }
      ],
      "src": [
        "P05"
      ],
      "frequency": "iterative"
    },
    {
      "id": "b03",
      "when": {
        "seq": -1,
        "approx": "on many occasions before Christmas Eve"
      },
      "kind": "habit",
      "place": null,
      "text": "Jim sometimes looked at his watch on the sly because of the old leather strap he used in place of a chain.",
      "who": [
        {
          "id": "jim",
          "role": "agent"
        }
      ],
      "src": [
        "P19"
      ],
      "frequency": "iterative",
      "things": [
        "watch",
        "strap"
      ]
    },
    {
      "id": "e01",
      "when": {
        "seq": 1,
        "approx": "Christmas Eve afternoon",
        "before": [
          "e10"
        ]
      },
      "kind": "act",
      "place": "flat",
      "text": "Della counted her savings, $1.87, three times; the next day was Christmas.",
      "who": [
        {
          "id": "della",
          "role": "agent"
        }
      ],
      "src": [
        "P01"
      ],
      "things": []
    },
    {
      "id": "e02",
      "when": {
        "seq": 2
      },
      "kind": "feeling",
      "place": "flat",
      "text": "Della flopped on the couch and howled; then powdered her cheeks and looked out at a grey cat on a grey fence, thinking of a present for Jim.",
      "who": [
        {
          "id": "della",
          "role": "experiencer"
        }
      ],
      "src": [
        "P02",
        "P06"
      ]
    },
    {
      "id": "e03",
      "when": {
        "seq": 3
      },
      "kind": "act",
      "place": "flat",
      "text": "Della turned to the pier-glass, her eyes shining and her face pale, and let down her hair; a tear fell on the carpet as she did it up again.",
      "who": [
        {
          "id": "della",
          "role": "agent"
        }
      ],
      "src": [
        "P07",
        "P08",
        "P10"
      ],
      "things": [
        "hair"
      ],
      "intent": "sell her hair to buy Jim a present",
      "importance": 4
    },
    {
      "id": "e04",
      "when": {
        "seq": 4
      },
      "kind": "depart",
      "place": "sofronie-shop",
      "text": "Della put on jacket and hat, went down to the street and up a flight to Mme. Sofronie's.",
      "who": [
        {
          "id": "della",
          "role": "agent"
        }
      ],
      "src": [
        "P11",
        "P12"
      ],
      "effects": [
        {
          "kind": "move",
          "of": "della",
          "to": "sofronie-shop"
        }
      ]
    },
    {
      "id": "e05",
      "when": {
        "seq": 5
      },
      "kind": "exchange",
      "place": "sofronie-shop",
      "text": "Della sold her hair to Mme. Sofronie for twenty dollars (the cutting itself is not narrated).",
