            }
          ],
          "location": "flat"
        },
        {
          "turn": 6,
          "round": 2,
          "text": "Jim stopped inside the door and stared fixedly at Della with an expression she could not read; it terrified her, though it was not anger, surprise, disapproval or horror.",
          "importance": 5,
          "tags": [
            "stare",
            "expression"
          ],
          "involves": [
            "jim",
            "della"
          ],
          "perceived_by": [
            {
              "character": "della",
              "mode": "witnessed",
              "content": "Jim looks at her with an expression she cannot read and fears.",
              "accuracy": "partial"
            }
          ],
          "location": "flat"
        },
        {
          "turn": 6,
          "round": 3,
          "text": "Della went to him and told him she had had her hair cut off and sold it because she could not live through Christmas without giving him a present, and that it would grow out again.",
          "importance": 4,
          "tags": [
            "hair",
            "confession"
          ],
          "involves": [
            "della",
            "jim"
          ],
          "perceived_by": [
