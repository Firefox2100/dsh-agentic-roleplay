            {
              "character": "jim",
              "mode": "witnessed"
            }
          ],
          "location": "flat"
        },
        {
          "turn": 6,
          "round": 6,
          "text": "Jim took a package from his overcoat pocket, threw it on the table and told her he would not love her less for any haircut, but that unwrapping it would show why he had stared.",
          "importance": 4,
          "tags": [
            "package",
            "reassurance"
