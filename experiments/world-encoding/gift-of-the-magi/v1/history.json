              "mode": "witnessed"
            }
          ],
          "location": "flat"
        },
        {
          "turn": 6,
          "round": 7,
          "text": "Della unwrapped the combs, screamed with joy, then burst into hysterical tears; Jim comforted her.",
          "importance": 5,
          "tags": [
            "combs",
            "joy",
            "tears"
          ],
