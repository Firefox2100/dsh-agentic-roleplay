          ],
          "perceived_by": [],
          "location": "flat"
        },
        {
          "turn": 1,
          "round": 3,
          "text": "Della turned suddenly from the window to the pier-glass, her eyes shining and her face pale, and let her hair fall to its full length; a tear or two fell on the carpet as she did it up again.",
