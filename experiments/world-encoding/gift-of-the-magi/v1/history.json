          ],
          "perceived_by": [],
          "location": "flat"
        },
        {
          "turn": 1,
          "round": 2,
          "text": "Della flopped on the shabby couch and howled, then powdered her cheeks and stood at the window looking at a grey cat on a grey fence.",
