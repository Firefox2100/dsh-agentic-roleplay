          "involves": [
            "jim",
            "della"
          ],
          "perceived_by": [
            {
              "character": "jim",
              "mode": "told",
              "content": "Della says the hair is sold and gone, and that she did it for him; she asks if she should put the chops on."
            },
            {
              "character": "della",
              "mode": "witnessed"
            }
          ],
          "location": "flat"
        },
        {
          "turn": 6,
          "round": 5,
          "text": "Jim came out of his trance and embraced Della.",
          "importance": 4,
          "tags": [
            "embrace"
