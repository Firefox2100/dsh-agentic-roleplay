        }
      ],
      "intent": "bring the news tenderly before others do"
    },
    {
      "id": "e07",
      "when": {
        "seq": 7,
        "precision": "unknown",
        "approx": "start of the hour"
      },
      "kind": "speech",
      "place": "house-downstairs",
      "text": "Josephine told Louise of her husband's death, in broken sentences and veiled hints; Richards was near.",
      "who": [
        {
          "id": "josephine",
          "role": "speaker"
        },
        {
          "id": "louise",
          "role": "addressee"
        },
        {
          "id": "richards",
          "role": "witness"
        }
      ],
      "src": [
        "P01",
        "P02"
      ],
      "importance": 5,
      "says": null,
      "says_note": "the words are not given: broken sentences and veiled hints",
      "causes": [
        {
          "event": "e05",
          "status": "implied"
        }
      ],
      "manner": "in broken sentences and veiled hints that half concealed what they revealed; great care taken because of f-heart"
    },
    {
      "id": "e08",
      "when": {
        "seq": 8,
        "precision": "unknown"
      },
      "kind": "feeling",
      "place": "house-downstairs",
      "text": "Louise wept at once, with wild abandonment, in her sister's arms.",
      "who": [
        {
          "id": "louise",
          "role": "experiencer"
        },
        {
          "id": "josephine",
          "role": "witness"
        }
      ],
      "src": [
        "P03"
      ],
      "causes": [
        {
          "event": "e07",
          "status": "stated"
        }
      ],
      "note": "she did not react with the paralysed inability to accept it that many women show"
    },
    {
      "id": "e09",
      "when": {
        "seq": 9,
        "precision": "unknown"
      },
      "kind": "depart",
      "place": "louise-room",
      "text": "Louise went away to her room alone and would have no one follow her.",
      "who": [
        {
          "id": "louise",
          "role": "agent"
        }
      ],
      "src": [
        "P03"
      ]
    },
    {
      "id": "e10",
      "when": {
        "seq": 10,
        "precision": "unknown"
      },
      "kind": "act",
      "place": "louise-room",
      "text": "Louise sank into the armchair facing the open window.",
      "who": [
        {
          "id": "louise",
          "role": "agent"
        }
      ],
      "src": [
        "P04"
      ],
      "things": [
        "armchair"
      ]
    },
    {
      "id": "e11",
      "when": {
        "seq": 11,
        "precision": "season",
        "approx": "spring"
      },
      "kind": "perceive",
      "place": "louise-room",
      "text": "Louise took in the spring scene: tree-tops, rain in the air, a peddler's cry, a distant song, sparrows, blue sky in the west.",
      "who": [
        {
          "id": "louise",
          "role": "experiencer"
        },
        {
          "id": "peddler",
          "role": "source"
        },
        {
          "id": "singer",
          "role": "source"
        }
      ],
      "src": [
        "P05"
      ]
    },
    {
      "id": "e12",
      "when": {
        "seq": 12,
        "precision": "unknown",
        "until": "e13",
        "approx": "a stretch while she sits"
      },
      "kind": "state",
      "place": "louise-room",
      "text": "Louise sat motionless, sobbing now and then, staring at a patch of blue sky.",
      "who": [
        {
          "id": "louise",
          "role": "experiencer"
        }
      ],
      "src": [
        "P06",
        "P07"
      ]
    },
    {
      "id": "e13",
      "when": {
        "seq": 13,
        "precision": "unknown"
      },
      "kind": "feeling",
      "place": "louise-room",
      "text": "Louise felt something approaching, struggled against it, abandoned herself and whispered 'free, free, free!'; fear gave way to bright eyes and quick pulse.",
      "who": [
        {
          "id": "louise",
          "role": "experiencer"
        }
      ],
      "src": [
        "P08",
        "P09"
      ],
      "importance": 5,
      "says": "free, free, free!",
      "causes": [
        {
          "event": "e07",
          "status": "implied"
        }
      ]
    },
    {
      "id": "e14",
      "when": {
        "seq": 14,
        "precision": "unknown"
      },
      "kind": "thought",
      "place": "louise-room",
      "text": "Louise reflected: she would weep at his dead hands, yet beyond that lay years belonging to her alone, with no will bending hers; she had loved him sometimes, often not.",
      "who": [
        {
          "id": "louise",
          "role": "experiencer"
        },
        {
          "id": "brently",
          "role": "subject"
        }
      ],
      "src": [
        "P10",
        "P11"
      ],
      "importance": 5
    },
    {
      "id": "e15",
      "when": {
        "seq": 15,
        "precision": "unknown"
      },
      "kind": "speech",
      "place": "louise-room",
      "text": "Louise kept whispering 'Free! Body and soul free!'",
      "who": [
        {
          "id": "louise",
          "role": "speaker"
        }
      ],
      "src": [
        "P12"
      ],
      "says": "Free! Body and soul free!"
    },
    {
      "id": "e16",
      "when": {
        "seq": 16,
        "precision": "unknown"
      },
      "kind": "speech",
      "place": "landing",
      "text": "Josephine knelt at the closed door, imploring; Louise answered 'Go away. I am not making myself ill.'",
      "who": [
        {
          "id": "josephine",
          "role": "speaker"
        },
        {
          "id": "louise",
          "role": "speaker"
        }
      ],
      "src": [
        "P13",
        "P14"
      ],
      "says": "(Josephine) Louise, open the door! I beg, open the door; you will make yourself ill. What are you doing, Louise? For heaven's sake open the door. (Louise) Go away. I am not making myself ill."
    },
    {
      "id": "e17",
      "when": {
        "seq": 17,
        "precision": "unknown"
      },
      "kind": "thought",
      "place": "louise-room",
      "text": "Louise breathed a quick prayer that life might be long and let her fancy run over spring and summer days to come.",
      "who": [
        {
          "id": "louise",
          "role": "experiencer"
        }
      ],
      "src": [
        "P14"
      ],
      "contrasts": [
        "e01"
      ]
    },
    {
      "id": "e18",
      "when": {
        "seq": 18,
        "precision": "unknown"
      },
      "kind": "act",
      "place": "house-downstairs",
      "text": "Louise opened the door, with feverish triumph in her eyes; she and Josephine descended the stairs, where Richards waited.",
      "who": [
        {
          "id": "louise",
          "role": "agent"
        },
        {
          "id": "josephine",
          "role": "agent"
        },
        {
          "id": "richards",
          "role": "witness"
        }
      ],
      "src": [
