      "when": {
        "seq": 5,
        "precision": "unknown"
      },
      "kind": "depart",
      "place": "newspaper-office",
      "text": "Richards hastened to the Mallard house to forestall any less careful friend in bearing the message.",
      "who": [
        {
          "id": "richards",
          "role": "agent"
        }
      ],
      "src": [
