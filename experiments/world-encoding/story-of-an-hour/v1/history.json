  {
    "clock": {
      "at": "1894-04-10T09:25",
      "note": "invented time"
    },
    "edit": {
      "turn": 3,
      "events": [
        {
          "turn": 3,
          "round": 1,
          "text": "Louise sank into the armchair facing the open window, pressed down by exhaustion.",
          "importance": 2,
          "tags": [
            "armchair",
            "exhaustion"
          ],
          "involves": [
            "louise"
          ],
          "perceived_by": [],
          "location": "louise-room"
        },
        {
          "turn": 3,
          "round": 2,
          "text": "From the window Louise saw the tops of trees aquiver with new spring life and patches of blue sky among the piled clouds in the west.",
          "importance": 2,
          "tags": [
            "spring",
            "window",
            "sky"
          ],
          "involves": [
            "louise"
          ],
          "perceived_by": [
            {
              "character": "louise",
              "mode": "witnessed"
            }
          ],
          "location": "louise-room"
        },
        {
          "turn": 3,
          "round": 3,
          "text": "A peddler cried his wares in the street, a distant song reached Louise faintly, and sparrows twittered in the eaves.",
          "importance": 2,
          "tags": [
            "spring",
            "sound"
          ],
          "involves": [
            "louise"
          ],
          "perceived_by": [
            {
              "character": "louise",
              "mode": "heard"
            }
          ],
          "location": "louise-room"
        },
        {
          "turn": 3,
          "round": 4,
          "text": "Louise sat motionless with her head thrown back, sobbing now and then, staring at a patch of blue sky with a dull, unthinking gaze.",
          "importance": 2,
          "tags": [
            "stillness",
            "stare"
          ],
          "involves": [
            "louise"
          ],
          "perceived_by": [],
          "location": "louise-room"
        },
        {
          "turn": 3,
          "round": 5,
          "text": "Louise felt something approaching, tried to beat it back with her will, then abandoned herself and whispered over and over: free, free, free.",
          "importance": 5,
          "tags": [
            "freedom",
            "turning-point"
          ],
          "involves": [
            "louise"
          ],
          "perceived_by": [
            {
              "character": "louise",
              "mode": "inferred",
              "content": "She recognised the thing as a monstrous, exalted joy of freedom."
            }
          ],
          "location": "louise-room"
        },
        {
          "turn": 3,
          "round": 6,
          "text": "Louise saw beyond the funeral a long procession of years that would belong to her absolutely, and welcomed them with open arms.",
          "importance": 5,
          "tags": [
            "freedom",
            "future",
            "imagined"
          ],
          "involves": [
            "louise"
          ],
          "perceived_by": [
            {
              "character": "louise",
              "mode": "inferred"
            }
          ],
          "location": "louise-room"
        },
        {
          "turn": 3,
          "round": 7,
          "text": "Louise whispered 'Free! Body and soul free!'",
          "importance": 4,
          "tags": [
            "freedom",
            "whisper"
          ],
          "involves": [
            "louise"
          ],
          "perceived_by": [],
          "location": "louise-room"
        }
      ],
      "beliefs": [
        {
          "character": "louise",
          "kind": "belief",
          "text": "I will weep when I see his kind hands folded in death, but beyond that the coming years will be mine alone; no one will bend my will.",
          "about": [
            "brently"
          ],
          "importance": 5,
          "confidence": "sure"
        },
        {
          "character": "louise",
          "kind": "relationship",
          "text": "I loved him sometimes; often I did not. Love counts for nothing against self-assertion.",
          "about": [
            "brently"
          ],
          "importance": 4,
          "confidence": "sure"
        }
      ],
      "states": [
        {
          "character": "louise",
          "public_state": "Sitting motionless in the armchair, staring at the sky.",
          "activity": "Sitting at the window.",
          "inner_state": "A fierce, exalted joy of freedom she does not dare name."
        }
      ]
    }
