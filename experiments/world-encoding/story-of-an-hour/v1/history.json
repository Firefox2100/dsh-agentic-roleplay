            },
            {
              "character": "richards",
              "mode": "witnessed"
            }
          ],
          "location": "house-downstairs"
        },
        {
          "turn": 2,
          "round": 2,
          "text": "Louise wept at once, with sudden wild abandonment, in her sister's arms.",
          "importance": 4,
          "tags": [
            "grief",
            "weeping"
          ],
          "involves": [
            "louise",
            "josephine"
