              "mode": "witnessed"
            }
          ],
          "location": "house-downstairs"
        },
        {
          "turn": 2,
          "round": 3,
          "text": "When the storm of grief had spent itself, Louise went away to her room alone and would have no one follow her.",
          "importance": 3,
          "tags": [
            "alone",
            "withdrawal"
          ],
          "involves": [
            "louise"
