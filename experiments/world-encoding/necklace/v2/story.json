      ]
    },
    {
      "id": "r-pride",
      "holder": "reader",
      "text": "Mathilde's pride in the repayment is the last thing she says before learning it was unnecessary.",
      "status": "implied",
      "supports": [
        "e23"
      ],
      "src": [
        "P125"
      ]
    },
    {
      "id": "r-c01",
