    {
      "id": "e23",
      "when": {
        "seq": 23
      },
      "kind": "speech",
      "place": "champs-elysees",
      "text": "Mathilde told her that she had lost the necklace, brought back another just like it, and spent ten years paying for it, and smiled with a proud and naive joy.",
