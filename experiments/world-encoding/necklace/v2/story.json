    {
      "id": "e10",
      "when": {
        "seq": 10
      },
      "kind": "perceive",
      "place": "loisel-flat",
      "text": "Before the glass Mathilde removed her wraps to see herself once more in her glory and found the necklace gone; she told Loisel, and they searched her dress, cloak and pockets in vain.",
      "who": [
        {
          "id": "mathilde",
          "role": "experiencer"
        },
        {
          "id": "loisel",
          "role": "agent"
        }
      ],
