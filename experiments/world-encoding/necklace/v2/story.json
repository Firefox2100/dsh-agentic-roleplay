      ],
      "importance": 5
    },
    {
      "id": "e11",
      "when": {
        "seq": 11
      },
      "kind": "speech",
      "place": "loisel-flat",
      "text": "Mathilde said she had felt it in the vestibule of the palace; Loisel reasoned it must be in the cab, but neither had noted its number; he put on his clothes and went back over the route on foot.",
      "who": [
        {
          "id": "loisel",
          "role": "speaker"
        },
        {
          "id": "mathilde",
          "role": "speaker"
        }
      ],
      "src": [
        "P69",
