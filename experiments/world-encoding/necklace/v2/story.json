  "readings": [
    {
      "id": "r-rank",
      "holder": "narrator",
      "text": "For women, natural fineness and charm replace caste and family; a pretty girl of a clerk's family can be as unhappy as a fallen lady.",
      "status": "stated",
      "supports": [
        "b01"
      ],
      "src": [
        "P01"
      ]
    },
    {
      "id": "r-strange",
      "holder": "narrator",
      "text": "How strange and changeful life is: how little a thing is needed for us to be lost or to be saved.",
      "status": "stated",
      "supports": [
        "r-c01"
      ],
      "src": [
        "P105"
      ]
    },
    {
      "id": "r-irony",
      "holder": "reader",
      "text": "Ten years' labour repaid a loan for an imitation; the loss that ruined them was a loss of paste.",
      "status": "implied",
      "supports": [
        "e24",
        "e19"
      ],
      "against": [
