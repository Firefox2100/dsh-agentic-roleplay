      ],
      "terms": "hold for three days; buy back at 34,000 francs if the original is found",
      "expires": "end of February",
      "importance": 5,
      "claims": [
        "e16"
      ]
    },
    {
      "id": "e17",
      "when": {
        "seq": 17,
        "after": [
          "e16"
        ],
        "gap": "P3D"
      },
      "kind": "exchange",
      "place": "jeweller-shops",
      "text": "Loisel, who had eighteen thousand francs from his father, borrowed the rest from many lenders, giving notes and dealing with usurers and risking his signature, and paid thirty-six thousand francs for the new necklace.",
      "who": [
        {
          "id": "loisel",
          "role": "agent"
        },
