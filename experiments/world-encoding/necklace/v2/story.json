      "when": {
        "seq": -18,
        "approx": "a long time"
      },
      "kind": "habit",
      "place": null,
      "text": "Mathilde stopped visiting a rich schoolmate from the convent because she suffered so when she came back.",
      "who": [
        {
          "id": "mathilde",
          "role": "agent"
        },
        {
          "id": "forestier",
          "role": "patient"
        }
      ],
      "src": [
