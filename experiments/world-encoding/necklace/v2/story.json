        }
      ]
    },
    {
      "id": "e05",
      "when": {
        "seq": 5,
        "after": [
          "e04"
        ],
        "gap": "P1D"
      },
      "kind": "exchange",
      "place": "forestier-home",
      "text": "The next day Mathilde told Mme. Forestier of her distress; Mme. Forestier brought out a jewel-box and let her choose; Mathilde tried bracelets, a pearl necklace and a Venetian cross, then found in a black satin box a superb diamond necklace and asked to borrow it, and Mme. Forestier agreed.",
      "who": [
        {
          "id": "mathilde",
          "role": "agent"
        },
        {
          "id": "forestier",
          "role": "agent"
        }
      ],
