          "e12"
        ],
        "gap": "P7D"
      },
      "kind": "state-change",
      "place": "loisel-flat",
      "text": "At the end of a week they had lost all hope; Loisel, who had aged five years, said they must replace the ornament.",
      "who": [
        {
          "id": "loisel",
          "role": "agent"
        },
        {
