      "when": {
        "seq": 16
      },
      "kind": "agreement",
      "place": "jeweller-shops",
      "text": "After going from jeweller to jeweller they found at the Palais Royal a string of diamonds that seemed exactly like the lost one, worth forty thousand and offered at thirty-six; they agreed that he would hold it three days and buy it back for thirty-four thousand if the original were found before the end of February.",
      "who": [
        {
          "id": "loisel",
          "role": "agent"
        },
        {
