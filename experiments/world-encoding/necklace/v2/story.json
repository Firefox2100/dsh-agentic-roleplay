    },
    {
      "id": "e01",
      "when": {
        "seq": 1,
        "approx": "a few weeks before the ball",
        "before": [
          "e06"
        ]
      },
      "kind": "act",
      "place": "loisel-flat",
      "text": "One evening Loisel came home with a large envelope containing an invitation to the Minister's ball on Monday evening, January 18th, and gave it to his wife.",
      "who": [
        {
          "id": "loisel",
          "role": "agent"
        },
        {
          "id": "mathilde",
          "role": "patient"
        }
      ],
      "src": [
        "P06",
        "P07",
        "P08",
        "P09"
      ],
      "things": [
        "invitation"
      ]
    },
    {
      "id": "e02",
      "when": {
        "seq": 2
      },
      "kind": "speech",
      "place": "loisel-flat",
      "text": "Mathilde threw the invitation down with disdain and said she had nothing to wear; Loisel, who had had trouble getting it, stammered about her theatre dress; she cried, then composed herself and said he should give the card to a better-equipped colleague's wife.",
      "who": [
        {
          "id": "mathilde",
          "role": "speaker"
        },
        {
          "id": "loisel",
          "role": "addressee"
        }
      ],
      "src": [
        "P10",
        "P11",
        "P12",
        "P13",
        "P14",
        "P15",
        "P16",
        "P17",
        "P18",
        "P19",
        "P20"
      ],
      "says": "What do you want me to put on my back? ... Nothing. Only I have no dress, and therefore I can't go to this ball.",
      "causes": [
        {
          "event": "e01",
          "status": "stated"
        }
      ]
    },
    {
      "id": "e03",
      "when": {
        "seq": 3
      },
      "kind": "exchange",
      "place": "loisel-flat",
      "text": "Loisel asked what a suitable dress would cost; Mathilde, calculating what she could ask without a refusal, said four hundred francs; he grew pale, since he was saving that sum for a gun, but agreed.",
      "who": [
        {
          "id": "loisel",
          "role": "agent"
        },
        {
          "id": "mathilde",
          "role": "agent"
        }
      ],
      "src": [
        "P21",
        "P22",
        "P23",
        "P24",
        "P25",
        "P26",
        "P27",
        "P28"
      ],
      "effects": [
        {
          "kind": "adjust",
          "of": "loisel",
          "what": "francs",
          "by": -400,
          "unit": "franc"
        },
        {
          "kind": "adjust",
          "of": "mathilde",
          "what": "francs",
          "by": 400,
          "unit": "franc"
        }
      ],
      "foregoes": "a gun and Sunday lark-shooting at Nanterre with friends next summer",
      "importance": 4
    },
    {
      "id": "e04",
      "when": {
        "seq": 4
      },
      "kind": "speech",
      "place": "loisel-flat",
      "text": "As the ball drew near, her dress ready, Mathilde grew sad because she had no jewel; Loisel suggested natural flowers at ten francs, she found that humiliating, and he told her to ask Mme. Forestier for jewels.",
      "who": [
        {
          "id": "mathilde",
          "role": "speaker"
        },
        {
          "id": "loisel",
          "role": "speaker"
        }
      ],
      "src": [
