  "events": [
    {
      "id": "b01",
      "when": {
        "seq": -20,
        "approx": "years before"
      },
      "kind": "state-change",
      "place": null,
      "text": "Mathilde let herself be married to a little clerk at the Ministry of Public Instruction, having no dowry and no expectations.",
      "who": [
        {
          "id": "mathilde",
          "role": "agent"
        },
        {
          "id": "loisel",
          "role": "agent"
        }
      ],
      "src": [
        "P01"
      ]
    },
    {
      "id": "b02",
      "when": {
        "seq": -19,
        "approx": "every day of the marriage"
      },
      "kind": "habit",
      "place": "loisel-flat",
      "text": "Mathilde suffered ceaselessly from the poverty of her dwelling and imagined silent ante-chambers, long salons, dainty dinners.",
      "who": [
        {
          "id": "mathilde",
          "role": "experiencer"
        },
        {
          "id": "servant",
          "role": "witness"
        }
      ],
      "src": [
