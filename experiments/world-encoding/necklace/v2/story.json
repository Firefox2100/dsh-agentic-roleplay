      ]
    },
    {
      "id": "e15",
      "when": {
        "seq": 15
      },
      "kind": "speech",
      "place": "jeweller-shops",
      "text": "They took the case to the jeweller named in it, who consulted his books and said he had not sold the necklace but must only have furnished the case.",
      "who": [
        {
          "id": "loisel",
          "role": "agent"
        },
        {
          "id": "mathilde",
          "role": "agent"
        },
        {
