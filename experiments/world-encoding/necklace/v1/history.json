      "turn": 1,
      "events": [
        {
          "turn": 1,
          "round": 1,
          "text": "Loisel came home triumphantly with an invitation to the Minister's ball at the palace on Monday evening, January 18th, and gave it to his wife.",
          "importance": 4,
          "tags": [
            "invitation",
            "ball"
          ],
          "involves": [
            "loisel",
            "mathilde"
          ],
          "perceived_by": [
