              "mode": "witnessed"
            }
          ],
          "location": "loisel-flat"
        },
        {
          "turn": 5,
          "round": 4,
          "text": "Mathilde had felt the necklace in the vestibule of the palace; they had not noted the cab's number; Loisel reasoned that it must be in the cab, and put on his clothes to retrace their route on foot.",
          "importance": 3,
          "tags": [
            "necklace",
            "reasoning",
            "cab"
          ],
          "involves": [
