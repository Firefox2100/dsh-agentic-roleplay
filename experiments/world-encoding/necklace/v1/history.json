              "character": "loisel",
              "mode": "witnessed"
            }
          ],
          "location": "loisel-flat",
          "items": [
            "invitation"
          ]
        },
        {
          "turn": 1,
          "round": 2,
          "text": "Mathilde threw the invitation on the table with disdain, saying she had nothing to wear; she cried, then composed herself and told him to give the card to a colleague whose wife was better equipped.",
          "importance": 4,
          "tags": [
            "dress",
            "tears",
            "disdain"
          ],
