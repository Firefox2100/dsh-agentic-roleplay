    "edit": {
      "turn": 4,
      "events": [
        {
          "turn": 4,
          "round": 1,
          "text": "At the ball Mme. Loisel was prettier than all, elegant, gracious and crazy with joy; all the men asked her name, the Cabinet attaches wanted to waltz with her, and the Minister remarked her.",
