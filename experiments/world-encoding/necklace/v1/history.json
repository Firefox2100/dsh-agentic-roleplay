              "mode": "witnessed"
            }
          ],
          "location": "ministry-palace"
        },
        {
          "turn": 4,
          "round": 2,
          "text": "Loisel slept from midnight in a little deserted ante-room with three other gentlemen whose wives were enjoying themselves.",
