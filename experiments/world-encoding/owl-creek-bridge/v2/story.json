  "events": [
    {
      "id": "b01",
      "when": {
        "seq": -10,
        "approx": "the months since the fall of Corinth"
      },
      "kind": "state-change",
      "place": null,
      "text": "Farquhar, an ardent secessionist, longed for a soldier's life he was kept from by circumstances 'unnecessary to relate'; he did what he could for the South.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        }
      ],
      "src": [
        "P09"
      ],
      "frequency": "iterative",
      "note": "the circumstances that kept him from service are withheld"
    },
    {
      "id": "e01",
      "when": {
        "seq": 1
      },
      "kind": "arrive",
      "place": "plantation-gate",
      "text": "One evening a gray-clad rider stopped at the gate and asked for water; Mrs. Farquhar served him with her own hands.",
      "who": [
        {
          "id": "scout",
          "role": "agent"
        },
        {
          "id": "wife",
          "role": "agent"
        },
        {
          "id": "farquhar",
          "role": "witness"
        }
      ],
      "src": [
        "P10",
        "P18"
      ]
    },
    {
      "id": "e02",
      "when": {
        "seq": 2
      },
      "kind": "speech",
      "place": "plantation-gate",
      "text": "Farquhar eagerly asked for news; the rider said the Yankees were repairing the railroads, had put the Owl Creek bridge in order, built a stockade on the north bank, and posted an order to hang any civilian interfering; the bridge was thirty miles off with only a picket post and a single sentinel on this side.",
      "who": [
        {
          "id": "scout",
          "role": "speaker"
        },
        {
          "id": "farquhar",
          "role": "addressee"
        }
      ],
      "src": [
        "P10",
        "P11",
        "P12",
        "P13",
        "P14",
        "P15"
      ],
      "says": "(Scout) The Yanks are repairing the railroads ... any civilian caught interfering ... will be summarily hanged. (Farquhar) How far is it? Is there no force this side? (Scout) About thirty miles. Only a picket post half a mile out, and a single sentinel at this end.",
      "claims": [
        "e02"
      ]
    },
    {
      "id": "e03",
      "when": {
        "seq": 3
      },
      "kind": "speech",
      "place": "plantation-gate",
      "text": "Farquhar asked, smiling, what a civilian could accomplish who eluded the picket and got the better of the sentinel.",
      "who": [
        {
          "id": "farquhar",
          "role": "speaker"
        },
        {
          "id": "scout",
          "role": "addressee"
        }
      ],
      "src": [
        "P16"
      ],
      "says": "Suppose a man, a civilian and student of hanging, should elude the picket post and perhaps get the better of the sentinel; what could he accomplish?"
    },
    {
      "id": "e04",
      "when": {
        "seq": 4
      },
      "kind": "speech",
      "place": "plantation-gate",
      "text": "The rider recalled that a month ago the flood had lodged a great quantity of driftwood against the pier at the near end of the bridge, now dry and burning like tow.",
      "who": [
        {
          "id": "scout",
          "role": "speaker"
        },
        {
          "id": "farquhar",
          "role": "addressee"
        }
      ],
      "src": [
        "P17"
      ],
      "says": "I observed that the flood of last winter had lodged a great quantity of driftwood against the wooden pier at this end of the bridge. It is now dry and would burn like tow.",
      "claims": [
        "c-driftwood"
      ],
      "importance": 5
    },
    {
      "id": "e05",
      "when": {
        "seq": 5,
        "after": [
          "e04"
        ],
        "gap": "PT1H"
      },
      "kind": "depart",
      "place": "road",
      "text": "The rider drank, thanked the lady, bowed to her husband and rode off; an hour later, after nightfall, he repassed the plantation going north.",
      "who": [
        {
          "id": "scout",
          "role": "agent"
        }
      ],
      "src": [
        "P18"
      ]
    },
    {
      "id": "e06",
      "when": {
        "seq": 6
      },
      "kind": "fact-stated",
      "place": null,
      "text": "The rider was a Federal scout.",
      "who": [
        {
          "id": "scout",
          "role": "subject"
        }
      ],
      "src": [
        "P18"
      ],
      "note": "stated by the narrator in the last sentence of the scene; Farquhar never learns it",
      "importance": 5
    },
    {
      "id": "e07",
      "when": {
        "seq": 7,
        "approx": "days after e05, before the morning of the hanging",
        "after": [
          "e05"
        ],
        "before": [
          "e09"
        ]
      },
      "kind": "act",
      "place": "south-approach",
      "text": "Farquhar acted on what he had been told: he went to the bridge to burn it.",
      "who": [
        {
          "id": "farquhar",
          "role": "agent"
        }
      ],
      "src": [],
      "importance": 5,
      "note": "never narrated; inferred from the order, the hanging and what the scout planted",
      "basis": "implied",
      "origin": "offscreen"
    },
    {
      "id": "e08",
      "when": {
        "seq": 8
      },
      "kind": "act",
      "place": "bridge-platform",
      "text": "Farquhar was caught while interfering with the bridge, and condemned under the commandant's order to be hanged from it.",
      "who": [
        {
          "id": "farquhar",
          "role": "patient"
        },
        {
          "id": "commandant",
          "role": "agent"
        }
      ],
      "src": [
        "P01",
        "P03"
      ],
      "causes": [
        {
          "event": "e07",
          "status": "implied"
        }
      ],
      "importance": 5,
      "basis": "implied",
      "origin": "offscreen"
    },
    {
      "id": "e09",
      "when": {
        "seq": 9,
        "approx": "early morning",
        "precision": "hour"
      },
      "kind": "state",
      "place": "bridge-platform",
      "text": "Farquhar stood on the bridge, wrists bound, noose around his neck, watched by captain, sergeant, two privates, a sentinel at each end, and a company at parade rest on the north slope; nobody moved.",
      "who": [
        {
          "id": "farquhar",
          "role": "patient"
        },
        {
          "id": "captain",
          "role": "witness"
        },
        {
          "id": "sergeant",
          "role": "agent"
        },
        {
          "id": "privates",
          "role": "agent"
        },
        {
          "id": "sentinels",
          "role": "witness"
        },
        {
          "id": "company",
          "role": "witness"
        },
        {
          "id": "lieutenant",
          "role": "witness"
        }
      ],
      "src": [
        "P01",
        "P02",
        "P03"
      ],
      "things": [
        "rope",
        "cannon"
      ]
    },
    {
      "id": "e10",
      "when": {
        "seq": 10
      },
      "kind": "act",
      "place": "bridge-platform",
      "text": "The privates stepped aside and drew away their planks; the sergeant and Farquhar stood on one plank, held by the sergeant's weight; at the captain's signal the sergeant would step aside and the plank would tilt.",
      "who": [
        {
          "id": "privates",
          "role": "agent"
        },
        {
          "id": "sergeant",
          "role": "agent"
        },
        {
          "id": "captain",
          "role": "agent"
        },
        {
          "id": "farquhar",
          "role": "patient"
        }
      ],
      "src": [
        "P04"
      ],
      "things": [
        "plank"
      ]
    },
    {
      "id": "e11",
      "when": {
        "seq": 11
      },
      "kind": "perceive",
      "place": "bridge-platform",
      "text": "Farquhar watched the water and a piece of driftwood, then closed his eyes to think of his wife and children; he heard a slow metallic ringing, hurting his ear: his watch ticking, stretched by his state.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        },
        {
          "id": "wife",
          "role": "subject"
        },
        {
          "id": "children",
          "role": "subject"
        }
      ],
      "src": [
        "P04",
        "P05"
      ],
      "things": [
        "watch"
      ],
      "distortion": "time seems to slow: the ticks come as slow as a death knell",
      "causes": []
    },
    {
      "id": "e12",
      "when": {
        "seq": 13
      },
      "kind": "act",
      "place": "bridge-platform",
      "text": "The captain nodded to the sergeant, who stepped aside; the plank tilted and Farquhar fell through the bridge.",
      "who": [
        {
          "id": "captain",
          "role": "agent"
        },
        {
          "id": "sergeant",
          "role": "agent"
        },
        {
          "id": "farquhar",
          "role": "patient"
        }
      ],
      "src": [
        "P07",
        "P20"
      ],
      "things": [
        "plank",
        "rope"
      ],
      "importance": 5
    },
    {
      "id": "e13",
      "when": {
        "seq": 14
      },
      "kind": "death",
      "place": "bridge-platform",
      "text": "The rope stopped Farquhar's fall and broke his neck; he died.",
      "who": [
        {
          "id": "farquhar",
          "role": "patient"
        }
      ],
      "src": [
        "P38",
        "P39"
      ],
      "things": [
        "rope"
      ],
      "causes": [
        {
          "event": "e12",
          "status": "stated"
        }
      ],
      "importance": 5,
      "note": "the moment is never narrated; P38 gives the blow and a light and sound like a cannon, P39 gives the dead body",
      "origin": "backfilled"
    },
    {
      "id": "e14",
      "when": {
        "seq": 15
      },
      "kind": "state",
      "place": "bridge-platform",
      "text": "Farquhar's body swung gently from side to side beneath the timbers of the bridge.",
      "who": [
        {
          "id": "farquhar",
          "role": "patient"
        }
      ],
      "src": [
        "P39"
      ],
      "things": [
        "rope"
      ]
    },
    {
      "id": "v01",
      "when": {
        "seq": 100
      },
      "kind": "sensation",
      "place": "bridge-platform",
      "text": "Farquhar fell and lost consciousness, then was awakened by the pain of pressure on his throat and by suffocation, and lived through burning pain and swinging like a pendulum in a luminous cloud.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        }
      ],
      "src": [
        "P20"
      ],
      "frame": "farquhar-vision",
      "grounded_in": [
        "e12",
        "e13"
      ],
      "note": "the noose tightening, rendered as pain and arcs of oscillation"
    },
    {
      "id": "v02",
      "when": {
        "seq": 101
      },
      "kind": "act",
      "place": "stream",
      "text": "The rope seemed to break and he fell into the stream, sank, then rose toward the light, thinking it not so bad to be hanged and drowned but that he did not want to be shot.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        }
      ],
      "src": [
        "P20"
      ],
      "frame": "farquhar-vision",
      "fulfils": "h-p01"
    },
    {
      "id": "v03",
      "when": {
        "seq": 102
      },
      "kind": "act",
      "place": "stream",
      "text": "His hands freed themselves and tore away the noose; he swam up against the pain and shrieked as his lungs filled with air.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        }
      ],
      "src": [
        "P21"
      ],
      "frame": "farquhar-vision",
      "fulfils": "h-p01",
      "grounded_in": [
        "e13"
      ]
    },
    {
      "id": "v04",
      "when": {
        "seq": 103
      },
      "kind": "perceive",
      "place": "stream",
      "text": "His senses became preternaturally keen: ripples, forest, leaves, insects, dewdrops, gnats, a fish.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        }
      ],
      "src": [
        "P22"
      ],
      "frame": "farquhar-vision"
    },
    {
      "id": "v05",
      "when": {
        "seq": 104
      },
      "kind": "perceive",
      "place": "stream",
      "text": "He saw the soldiers on the bridge shouting and pointing, the captain with his pistol drawn; a sentinel fired and missed, his gray eye through the sights.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        },
        {
          "id": "captain",
          "role": "subject"
        },
        {
          "id": "sentinels",
          "role": "agent"
        }
      ],
      "src": [
        "P23",
        "P24"
      ],
      "frame": "farquhar-vision"
    },
    {
      "id": "v06",
      "when": {
        "seq": 105
      },
      "kind": "act",
      "place": "stream",
      "text": "The lieutenant's chant of commands rang out; Farquhar dived; a volley's flattened bullets fell around him; later the soldiers reloaded, the sentinels fired again, and a cannon shot plashed within two yards.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        },
        {
          "id": "lieutenant",
          "role": "agent"
        },
        {
          "id": "company",
          "role": "agent"
        }
      ],
      "src": [
        "P25",
        "P26",
        "P27",
        "P28",
        "P29",
        "P30",
        "P31",
        "P32"
      ],
      "frame": "farquhar-vision",
      "says": "Attention, company! Shoulder arms! Ready! Aim! Fire!"
    },
    {
      "id": "v07",
      "when": {
        "seq": 106
      },
      "kind": "act",
      "place": "stream",
      "text": "He was whirled in a vortex and flung on the gravel of the south bank, hidden from his enemies; the sand looked like gems and the trees like garden plants; a grapeshot's whiz roused him and he ran into the forest.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        }
      ],
      "src": [
        "P33",
        "P34"
      ],
      "frame": "farquhar-vision"
    },
    {
      "id": "v08",
      "when": {
        "seq": 107
      },
      "kind": "act",
      "place": null,
      "text": "All that day he traveled through an interminable forest, found at nightfall a wide, straight, untraveled road under unfamiliar stars, and heard whispers in an unknown tongue.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        }
      ],
      "src": [
        "P35",
        "P36"
      ],
      "frame": "farquhar-vision",
      "note": "the journey of a day and a night, at 'about thirty miles'"
    },
    {
      "id": "v09",
      "when": {
        "seq": 108
      },
      "kind": "sensation",
      "place": null,
      "text": "His neck was swollen and bruised, his tongue swollen with thirst, his eyes could not close.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        }
      ],
      "src": [
        "P37"
      ],
      "frame": "farquhar-vision",
      "grounded_in": [
        "e13"
      ],
      "note": "the bruise from the rope"
    },
    {
      "id": "v10",
      "when": {
        "seq": 109
      },
      "kind": "act",
      "place": "farquhar-home",
      "text": "He seemed to wake and stood at the gate of his home in the morning sun; his wife came down from the veranda to meet him with a smile of ineffable joy; as he sprang forward to embrace her he felt a stunning blow upon the neck and a blinding white light like a cannon, and then darkness and silence.",
      "who": [
        {
          "id": "farquhar",
          "role": "experiencer"
        },
        {
          "id": "wife",
          "role": "subject"
        }
      ],
      "src": [
        "P38"
      ],
      "frame": "farquhar-vision",
      "grounded_in": [
        "e13"
      ],
      "tense": "present",
      "note": "the telling shifts to the present tense; the blow is the neck breaking"
    }
  ],
  "held": [
    {
      "id": "h-p01",
