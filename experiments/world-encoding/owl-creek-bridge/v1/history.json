            "farquhar",
            "scout"
          ],
          "perceived_by": [
            {
              "character": "farquhar",
              "mode": "told",
              "content": "The Yankees have taken the Owl Creek bridge, thirty miles away, guarded by a picket post and one sentinel at this end; civilians who interfere will be hanged.",
