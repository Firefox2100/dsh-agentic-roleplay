{
  "name": "@dsh-agentic-roleplay/state",
  "version": "0.8.0",
  "description": "DSH plugin for roleplay session state: one SQLite database per session, exposed to other plugins as a service over canonical models.",
  "author": {"name": "Firefox2100", "url": "https://github.com/Firefox2100"},
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.2.2"
  },
  "repository": {"type": "git", "url": "git+https://github.com/Firefox2100/dsh-agentic-roleplay.git", "directory": "packages/dsh-roleplay-state"},
  "homepage": "https://firefox2100.github.io/dsh-agentic-roleplay/docs/developers/state",
  "bugs": {"url": "https://github.com/Firefox2100/dsh-agentic-roleplay/issues"},
  "keywords": ["deepseek-harness", "dsh", "agentic-roleplay", "sqlite", "memory"],
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "postpack": "node -e \"require('node:fs').rmSync('LICENSE', { force: true })\""
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "GPL-3.0-only",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.20.0",
    "dsh-roleplay-model": "workspace:*",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
