      "triggers",
      "routines",
      "calendar",
      "rules"
    ],
    "why": "The story that goes on while the player is away: on the real clock with the shortest idle time and gap, the player stays in the shop and does nothing for twenty minutes, and a character who is elsewhere and knows the player (the rider, the landlord) may write. Needs the rig's plugin setting autonomyTickSeconds at 30 or less. The chance of a message per look is raised to 0.5 so that the row tests the writing and not the luck of the draw (at the default 0.05 a quiet twenty minutes is likely).",
    "script": "autonomy-zh",
    "report": [
      "autonomy"
    ],
    "settings": {
      "clock": {
        "mode": "real"
      },
      "autonomy": {
        "enabled": true,
        "idleMinutes": 5,
        "messageGapMinutes": 5,
        "maxUnanswered": 2,
        "chance": 0.5
      }
    }
  },
