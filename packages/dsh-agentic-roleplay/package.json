{
  "name": "@dsh-agentic-roleplay/all",
  "version": "0.5.0",
  "description": "Agentic roleplay bundle for DeepSeek Harness. Install this one package to get every roleplay plugin.",
  "author": {"name": "Firefox2100", "url": "https://github.com/Firefox2100"},
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {"node": ">=22", "dsh": ">=0.2.1-rc.2 <0.2.2"},
  "repository": {"type": "git", "url": "git+https://github.com/Firefox2100/dsh-agentic-roleplay.git", "directory": "packages/dsh-agentic-roleplay"},
  "homepage": "https://firefox2100.github.io/dsh-agentic-roleplay/docs/intro",
  "bugs": {"url": "https://github.com/Firefox2100/dsh-agentic-roleplay/issues"},
  "keywords": ["deepseek-harness", "dsh", "agentic-roleplay", "roleplay", "plugin-bundle"],
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "scripts": {
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "postpack": "node -e \"require('node:fs').rmSync('LICENSE', { force: true })\""
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-speech-to-text-sensevoice": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-api-speech-to-text": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-voice-input": "0.2.1-rc.2",
    "@dsh-agentic-roleplay/core": "workspace:0.5.0",
    "@dsh-agentic-roleplay/state": "workspace:0.5.0"
  }
}
